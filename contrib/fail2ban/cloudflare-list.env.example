# Copied to /etc/fail2ban/cloudflare-list.env (mode 600). Never commit the filled-in file.
# Token scope: Account → Account Filter Lists: Edit. Nothing else.
CF_API_TOKEN=
CF_ACCOUNT_ID=
# The same IP list wicket uses (CF_LIST_ID in wicket's secrets); the zone WAF rule
# "ip.src in $wicket_banned → block" enforces it on every Cloudflare-proxied host.
CF_LIST_ID=
